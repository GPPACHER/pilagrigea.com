---
// 404 — this fish is not in the school.
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404 — fish not found — PIL.AGRIGEA" description="This fish is not in the school.">
  <section class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-8); text-align: center;">
    <p class="hero__kicker">ERROR 404</p>
    <h1>This fish is not in the school</h1>
    <p class="lede" style="margin: var(--space-4) auto; max-width: 34rem;">
      The current is empty here. The fish you are looking for has not been
      written yet — or it swam into the hadal zone and never surfaced.
    </p>
    <p>
      <a class="btn" href="/">← Back to the observation deck</a>
    </p>
  </section>
</BaseLayout>
